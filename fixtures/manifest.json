  "coverage": {
    "strategy": "feature-covering",
    "rules": [
      "Every proven feature has a model or positive witness.",
      "Every accepted boundary has a nearest rejected or malformed witness.",
      "Runtime facts do not imply Android framework or device behavior.",
      "Unknown features never count as a support claim."
    ]
  },
  "features": [
    {
      "id": "elf.identity.aarch64-et-dyn",
      "status": "proven",
      "obligation": "ELF64 little-endian AArch64 ET_DYN identity and bounded load map",
