    {
      "id": "runtime.host-context.pt-tls",
      "status": "rejected",
      "obligation": "The HostContext v1 adapter rejects PT_TLS before creating an image handle because its system-loader contract does not define TLS or thread lifetime semantics",
      "witness": "native/urprotect-runtime/host_context_self_test.c",
      "oracle": "native/urprotect-runtime/host_adapter.c",
      "evidence": [
        "native/urprotect-runtime/host_adapter.c",
        "native/urprotect-runtime/host_context_self_test.c",
        "native/urprotect-runtime/host_context_entry_fixture.c",
        ".artifacts/host-context/pr/self-test.log"
      ],
      "reason": "HostContext v1 does not define TLS module allocation, per-thread initialization, TLS relocation models, thread creation/reentrancy, or TLS teardown relative to release_image; dlopen acceptance alone is not a compatibility proof.",
      "negativeWitness": "native/urprotect-runtime/host_context_self_test.c",
      "negativeOracle": "native/urprotect-runtime/host_adapter.c",
      "constraints": [
        "The unchanged entry fixture is the positive HostContext dispatch baseline.",
        "A structurally bounded PT_TLS mutation is rejected with URP_STATUS_UNSUPPORTED and a zero image handle.",
        "A PT_TLS mutation with p_filesz greater than p_memsz is rejected with URP_STATUS_LOAD_FAILED before any loader handoff.",
        "No positive TLS HostContext fixture or support claim exists until the Host Contract defines TLS and thread lifetime semantics."
      ]
    },
