      ],
      "reason": "HostContext v1 and the current system-loader adapter define no GNU property negotiation or BTI/PAC/instruction-state obligations; dlopen acceptance of a property note alone is not a compatibility proof.",
      "negativeWitness": "native/urprotect-runtime/host_context_self_test.c",
      "negativeOracle": "native/urprotect-runtime/host_adapter.c",
      "constraints": [
        "The unchanged entry fixture is the positive HostContext dispatch baseline.",
        "A bounded PT_LOAD-covered metadata segment mutation to PT_GNU_PROPERTY is rejected with URP_STATUS_UNSUPPORTED and a zero image handle before loader handoff.",
        "No positive GNU property HostContext fixture or support claim exists until the Host Contract defines property negotiation and BTI/PAC/instruction-state semantics."
      ]
    },
