      "id": "runtime.host-context-v1",
      "status": "validated",
      "obligation": "Versioned HostContext v1 callbacks and the legacy frame provide immutable AArch64 ET_DYN image loading and explicit entry dispatch for the declared adapter slice",
      "witness": "native/urprotect-runtime/host_context_entry_fixture.c",
      "oracle": "native/urprotect-runtime/host_context_self_test.c",
      "evidence": [
        "src/UrProtect.Core/Pack/HostContextContract.cs",
