        "native/urprotect-runtime/README.md",
        ".artifacts/host-context/pr/self-test.log"
      ],
      "constraints": [
        "No PT_INTERP, DT_NEEDED, constructor, path-search, or text-relocation semantics",
        "Dynamic flags are limited to immediate binding flags; other lifecycle or relocation flags are rejected",
        "Only checked AArch64 RELATIVE/RELR relocation targets are accepted; application and memory protection are delegated to the recorded native system loader"
      ]
    },
    {
      "id": "runtime.host-context-v2",
      "status": "validated",
      "obligation": "HostContext frame v2 carries the ABI, required capabilities, and bounded entry symbol through one frame-relative layout and dispatches the declared entry without a temporary executable path",
      "witness": "tests/UrProtect.Core.Tests/PayloadFrameTests.cs",
      "oracle": "native/urprotect-runtime/host_context_self_test.c",
      "evidence": [
        "src/UrProtect.Core/Pack/HostContextContract.cs",
