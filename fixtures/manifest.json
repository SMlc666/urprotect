        "tests/UrProtect.Core.Tests/BinaryPropertyTests.cs"
      ]
    },
    {
      "id": "elf.load-layout.alignment-congruence",
      "status": "proven",
      "obligation": "Each AArch64 ET_DYN PT_LOAD with p_align greater than one uses a power-of-two alignment and congruent p_offset and p_vaddr residues, including non-page-sized alignment",
      "witness": "tests/UrProtect.Core.Tests/ElfParserTests.cs",
      "oracle": "src/UrProtect.Core/Elf/ElfParser.cs",
      "evidence": [
        "tests/UrProtect.Core.Tests/ElfParserTests.cs",
        "tests/UrProtect.Core.Tests/ElfFixture.cs",
        "src/UrProtect.Core/Elf/ElfParser.cs"
      ],
      "negativeWitness": "tests/UrProtect.Core.Tests/ElfParserTests.cs",
      "negativeOracle": "tests/UrProtect.Core.Tests/ElfParserTests.cs"
    },
    {
      "id": "elf.dynamic",
      "status": "proven",
      "obligation": "PT_DYNAMIC and dynamic metadata are mapped and bounded",
      "witness": "tests/UrProtect.Core.Tests/ElfParserTests.cs",
      "oracle": "src/UrProtect.Core/Elf/ElfParser.cs",
      "evidence": [
        "tests/UrProtect.Core.Tests/ElfParserTests.cs"
      ]
    },
    {
      "id": "elf.relocation.aarch64-relative",
      "status": "validated",
      "obligation": "The narrow HostContext adapter accepts AArch64 RELATIVE/RELR relocation targets in writable load segments and delegates application to the native loader",
      "witness": "native/urprotect-runtime/host_context_entry_fixture.c",
      "oracle": "native/urprotect-runtime/host_adapter.c",
      "evidence": [
        "native/urprotect-runtime/host_adapter.c",
        "native/urprotect-runtime/host_context_self_test.c",
        "native/urprotect-runtime/host_context_entry_fixture.c",
        ".artifacts/host-context/pr/self-test.log"
      ],
      "constraints": [
        "AArch64 RELA entries must be NONE or RELATIVE with symbol index zero",
        "RELR targets must be aligned and writable",
        "Dynamic flag entries allow only immediate binding flags; text-relocation flags are rejected",
        "The system loader remains responsible for applying accepted relocations"
      ]
    },
    {
      "id": "elf.sectionless-program-headers",
      "status": "proven",
      "obligation": "A valid ET_DYN remains parseable when section headers are absent; program headers remain authoritative",
      "witness": "tests/UrProtect.Core.Tests/ElfParserTests.cs",
      "oracle": "src/UrProtect.Core/Elf/ElfParser.cs",
      "evidence": [
        "tests/UrProtect.Core.Tests/ElfParserTests.cs",
        "tests/UrProtect.Core.Tests/ElfMalformedCorpusTests.cs"
      ],
      "negativeWitness": "tests/UrProtect.Core.Tests/ElfMalformedCorpusTests.cs",
      "negativeOracle": "tests/UrProtect.Core.Tests/ElfMalformedCorpusTests.cs"
    },
    {
      "id": "runtime.host-context.sectionless-image",
      "status": "validated",
      "obligation": "A HostContext AArch64 ET_DYN remains loadable when section headers are absent; program headers and dynamic metadata remain authoritative",
      "witness": "native/urprotect-runtime/host_context_self_test.c",
      "oracle": "native/urprotect-runtime/host_adapter.c",
      "evidence": [
        "native/urprotect-runtime/host_adapter.c",
        "native/urprotect-runtime/host_context_self_test.c",
        "native/urprotect-runtime/host_context_entry_fixture.c",
        ".artifacts/host-context/pr/self-test.log"
      ],
      "constraints": [
        "The image must still provide bounded AArch64 PT_LOAD and PT_DYNAMIC program headers",
        "This validates the native adapter slice and does not claim broader loader behavior"
      ]
    },
    {
      "id": "runtime.host-context.gnu-relro",
      "status": "validated",
      "obligation": "A bounded PT_GNU_RELRO program header has a file-backed range inside the AArch64 image with p_memsz >= p_filesz, and the retained image completes HostContext entry dispatch",
      "witness": "native/urprotect-runtime/host_context_self_test.c",
      "oracle": "native/urprotect-runtime/host_adapter.c",
      "evidence": [
        "native/urprotect-runtime/host_context_self_test.c",
        "native/urprotect-runtime/host_context_entry_fixture.c",
        "native/urprotect-runtime/host_adapter.c",
        ".artifacts/host-context/pr/self-test.log"
      ],
      "constraints": [
        "The self-test covers only a bounded PT_GNU_RELRO program-header file range and p_memsz >= p_filesz",
        "The unmodified image retaining PT_GNU_RELRO must dispatch through the real adapter with status 23",
        "Memory protection semantics remain delegated to the native system loader; this is validated implementation evidence, not proof of a custom RELRO implementation"
      ]
    },
    {
      "id": "runtime.host-context.gnu-stack",
      "status": "validated",
      "obligation": "The HostContext adapter accepts a PT_GNU_STACK program header when PF_X is clear and rejects an executable PT_GNU_STACK before creating an image handle",
      "witness": "native/urprotect-runtime/host_context_self_test.c",
      "oracle": "native/urprotect-runtime/host_adapter.c",
      "evidence": [
        "native/urprotect-runtime/host_adapter.c",
        "native/urprotect-runtime/host_context_self_test.c",
        "native/urprotect-runtime/host_context_entry_fixture.c",
        ".artifacts/host-context/pr/self-test.log"
      ],
      "negativeWitness": "native/urprotect-runtime/host_context_self_test.c",
      "negativeOracle": "native/urprotect-runtime/host_adapter.c",
      "constraints": [
        "The real fixture must contain PT_GNU_STACK with PF_X clear and must complete HostContext dispatch through the unchanged adapter path",
        "The self-test sets only the PT_GNU_STACK p_flags PF_X bit in one bounded image copy and requires URP_STATUS_UNSUPPORTED with a zero image handle before loading",
        "Memory protection remains delegated to the native system loader for the accepted non-executable GNU_STACK case; this is validated implementation evidence, not proof of custom stack-protection semantics"
      ]
    },
